{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": [
				"VITE_API_URL",
				"VITE_SITE_URL"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*"
			],
			"outputs": [
				".next/**",
				"!.next/cache/**",
				".output/**",
				"dist/**"
			]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {
			"outputs": [],
			"env": ["DATABASE_URL"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
