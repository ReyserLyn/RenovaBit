{
	"name": "renovabit",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@base-ui/react": "^1.5.0",
			"@biomejs/biome": "2.5.14",
			"@hugeicons/core-free-icons": "4.3.3",
			"@hugeicons/react": "^1.1.6",
			"@tailwindcss/vite": "^4.1.18",
			"@tanstack/router-cli": "^1.167.38",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.2",
			"better-auth": "^1.6.15",
			"better-themes": "^1.1.0",
			"bun-types": "^1.3.10",
			"class-variance-authority": "^0.7.1",
			"drizzle-orm": "0.45.2",
			"nanoid": "6.0.1",
			"react": "^19.3.0",
			"react-dom": "^19.3.0",
			"serialize-error": "13.0.1",
			"slugify": "^1.6.9",
			"sonner": "^2.0.7",
			"typescript": "7.0.2",
			"react-day-picker": "^9.11.1",
			"date-fns": "^4.1.0",
			"@date-fns/tz": "^1.5.0",
			"zod": "^4.4.3"
		}
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"check": "biome check . --write",
		"check:biome": "biome check . --write",
		"check-types": "turbo run check-types",
		"gen:image": "bun --env-file=.env apps/tienda/scripts/gen-image.ts",
		"test": "turbo run test",
		"clean": "bun run clean:turbo && bun run clean:dist",
		"clean:all": "bun run clean && bun run clean:node_modules",
		"clean:turbo": "find . -path ./docker-volumes -prune -o -name \".turbo\" -type d -prune -exec rm -rf {} +",
		"clean:dist": "find . \\( -path ./docker-volumes -o -path '*/node_modules' \\) -prune -o -name \"dist\" -type d -prune -exec rm -rf {} +",
		"clean:node_modules": "find . -path ./docker-volumes -prune -o -name \"node_modules\" -type d -prune -exec rm -rf {} +"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@renovabit/biome-config": "*",
		"@renovabit/ts-config": "*",
		"lefthook": "^2.1.6",
		"turbo": "^2.11.2",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.10",
	"dependencies": {
		"nitro": "^3.0.260903-beta"
	}
}
