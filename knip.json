{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		"apps/api": {
			"entry": [
				"src/index.ts",
				"src/plugins/**/*.ts",
				"src/modules/**/index.ts"
			],
			"project": [
				"src/**/*.ts",
				"!src/**/*.test.ts",
				"!src/**/__tests__/**"
			],
			"ignore": [
				"src/constants.ts",
				"src/utils/**/*.ts",
				"src/plugins/**/*.ts"
			],
			"ignoreExportsUsedInFile": true,
			"ignoreDependencies": [
				"@renovabit/pricing",
				"@renovabit/db"
			]
		},
		"apps/admin": {
			"entry": [
				"src/routes/**/*.{ts,tsx}",
				"src/router.tsx",
				"src/main.tsx",
				"src/shared/integrations/**/*.tsx",
				"src/shared/components/data-grid/**/*.{ts,tsx}",
				"src/shared/components/{sidebar,layout}/**/*.{ts,tsx}"
			],
			"project": ["src/**/*.{ts,tsx}"],
			"ignore": [
				"src/shared/components/error/**/*.{ts,tsx}",
				"src/shared/components/ui/**/*.{ts,tsx}",
				"src/shared/lib/api/**/*.{ts,tsx}",
				"src/shared/lib/auth/**/*.{ts,tsx}",
				"src/shared/lib/env.ts",
				"src/shared/lib/format-currency.ts",
				"src/shared/lib/format-date.ts",
				"src/shared/lib/hooks/**/*.{ts,tsx}",
				"src/shared/lib/storage/**/*.{ts,tsx}",
				"src/shared/lib/stores/**/*.{ts,tsx}",
				"src/shared/lib/string.ts",
				"src/shared/lib/slug.ts",
				"src/shared/lib/contact.ts",
				"src/shared/lib/form/**/*.{ts,tsx}",
				"src/shared/config/**/*.{ts,tsx}",
				"src/shared/styles/**/*.css",
				"src/shared/hooks/**/*.{ts,tsx}"
			],
			"ignoreDependencies": [
				"@renovabit/backend-client",
				"@renovabit/db",
				"@renovabit/pricing",
				"@renovabit/ui"
			]
		},
		"apps/tienda": {
			"entry": [
				"src/routes/**/*.{ts,tsx}",
				"src/router.tsx",
				"src/main.tsx",
				"src/features/**/hooks/server.ts",
				"src/shared/integrations/**/*.{ts,tsx}"
			],
			"project": ["src/**/*.{ts,tsx}"],
			"ignore": [
				"src/shared/components/**/*.{ts,tsx}",
				"src/shared/lib/api/**/*.{ts,tsx}",
				"src/shared/lib/auth/**/*.{ts,tsx}",
				"src/shared/lib/env.ts",
				"src/shared/lib/format.ts",
				"src/shared/lib/clipboard.ts",
				"src/shared/lib/contact.ts",
				"src/shared/lib/form/**/*.{ts,tsx}",
				"src/shared/lib/filters/**/*.{ts,tsx}",
				"src/shared/lib/hooks/**/*.{ts,tsx}",
				"src/shared/lib/router/**/*.{ts,tsx}",
				"src/shared/lib/seo.ts",
				"src/shared/lib/slug.ts",
				"src/shared/lib/stores/**/*.{ts,tsx}",
				"src/shared/styles/**/*.css",
				"src/shared/hooks/**/*.{ts,tsx}"
			],
			"ignoreDependencies": [
				"@renovabit/backend-client",
				"@renovabit/db",
				"@renovabit/pricing",
				"@renovabit/ui"
			]
		},
		"apps/landing": {
			"entry": [
				"src/pages/**/*.astro",
				"src/layouts/**/*.astro",
				"src/components/**/*.{ts,tsx,astro}",
				"src/styles/**/*.css"
			],
			"project": [
				"src/**/*.{ts,tsx,astro,css}"
			],
			"ignoreDependencies": [
				"@renovabit/ui"
			]
		},
		"packages/db": {
			"entry": [
				"src/index.ts",
				"src/orders.ts",
				"src/orders-meta.ts"
			],
			"project": ["src/**/*.ts"],
			"ignore": ["src/relations.ts"],
			"ignoreExportsUsedInFile": true
		},
		"packages/pricing": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"],
			"ignoreExportsUsedInFile": true
		},
		"packages/ui": {
			"entry": [
				"src/index.ts",
				"src/lib/**/*.ts"
			],
			"project": ["src/**/*.{ts,tsx}"],
			"ignore": ["src/styles/**/*.css"]
		},
		"packages/backend-client": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"],
			"ignoreExportsUsedInFile": true
		}
	},
	"ignoreDependencies": [
		"@renovabit/pricing",
		"@renovabit/db",
		"@renovabit/backend-client"
	],
	"ignoreExportsUsedInFile": true,
	"ignore": [
		"**/globals.css",
		"**/*.css"
	],
	"include": [
		"files",
		"dependencies",
		"devDependencies",
		"exports",
		"types"
	]
}
