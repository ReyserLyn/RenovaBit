---
import "@/styles/landing.css"
import { Font } from "astro:assets"
import { ClientRouter } from "astro:transitions"
import { SITE } from "@/constants"

interface Props {
	title: string
	description?: string
	ogImage?: string
}

const { title, description = SITE.description, ogImage = SITE.ogImage } = Astro.props

const pageTitle = `${title} — ${SITE.name}`
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).toString()
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE.author} />

		<!-- Canonical -->
		<link rel="canonical" href={canonicalUrl} />

		<!-- Open Graph -->
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content={SITE.locale} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={new URL(ogImage, SITE.url).toString()} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImage, SITE.url).toString()} />

		<link rel="icon" href="/favicon.ico" />

		<!-- Outfit (body / UI / subhead / features / CTAs / trust) -->
		<Font
			cssVariable="--font-outfit"
			preload={[{ weight: "400" }, { weight: "500" }, { weight: "700" }]}
		/>

		<!-- Urbanist (display, headlines) — preload only the critical 700 -->
		<Font cssVariable="--font-urbanist" preload={[{ weight: "700" }]} />

		<!-- Azonix (display accent, eyebrow) — single weight, preloaded -->
		<Font cssVariable="--font-azonix" preload={[{ weight: "400" }]} />

		<ClientRouter />
	</head>

	<body class="bg-background text-foreground font-sans antialiased">
		<a href="#main" class="skip-link">Saltar al contenido principal</a>

		<slot name="header" />

		<main id="main" tabindex="-1" class="flex min-h-svh w-full flex-col">
			<slot />
		</main>
	</body><style>
		/* WCAG 2.4.1 — skip link: hidden until focused, then appears at the top */
		.skip-link {
			position: absolute;
			top: 0.5rem;
			left: 0.5rem;
			z-index: 100;
			padding: 0.625rem 1rem;
			background: var(--primary);
			color: var(--primary-foreground);
			border-radius: var(--radius);
			font-weight: 500;
			text-decoration: none;
			transform: translateY(-200%);
			transition: transform 150ms ease-out;
		}
		.skip-link:focus {
			transform: translateY(0);
			outline: 2px solid var(--ring);
			outline-offset: 2px;
		}
		/* Let the skip target actually receive focus from the anchor jump */
		main:focus {
			outline: none;
		}
	</style>
</html>
