---
import type { HTMLAttributes } from "astro/types"
import { buttonVariants } from "@renovabit/ui/lib/button-variants"
import { cn } from "@renovabit/ui/lib/utils"

type ButtonAsButton = {
	as?: "button"
	variant?:
		| "default"
		| "mono"
		| "outline"
		| "secondary"
		| "ghost"
		| "ghost-accent"
		| "destructive"
		| "link"
	size?: "default" | "xs" | "sm" | "lg" | "icon" | "icon-xs" | "icon-sm" | "icon-lg"
} & HTMLAttributes<"button">

type ButtonAsAnchor = {
	as: "a"
	variant?:
		| "default"
		| "mono"
		| "outline"
		| "secondary"
		| "ghost"
		| "ghost-accent"
		| "destructive"
		| "link"
	size?: "default" | "xs" | "sm" | "lg" | "icon" | "icon-xs" | "icon-sm" | "icon-lg"
} & HTMLAttributes<"a">

export type Props = ButtonAsButton | ButtonAsAnchor

const {
	as: Tag = "button",
	variant = "default",
	size = "default",
	class: className = "",
	...rest
} = Astro.props as Props
---

{
	/*
	TS no reconcilia la unión discriminada con un Tag dinámico.
	El tipo público Props SÍ es estricto (href solo cuando as="a"),
	pero JSX pide intersección. Suprimimos el error interno y confiamos en Props.
*/
}
<!-- @ts-expect-error Props union + Tag dinámico confunden JSX -->
<Tag
	data-slot="button"
	data-variant={variant}
	data-size={size}
	class={cn(buttonVariants({ variant, size }), className)}
	{...rest}
>
	<slot />
</Tag>
