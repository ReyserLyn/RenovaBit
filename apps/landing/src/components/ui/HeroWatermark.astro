---
/**
 * HeroWatermark — Texto decorativo de fondo con palabras clave
 * dispersas, rotadas y enmascaradas para no estorbar el contenido.
 */
---

<div
	class="pointer-events-none absolute inset-0 overflow-hidden select-none z-0"
	aria-hidden="true"
>
	<div
		class="absolute top-[5%] -left-10 w-full h-full text-[color-mix(in_oklab,var(--foreground)_10%,transparent)] font-bold tracking-tight leading-none mask-[radial-gradient(ellipse_65%_55%_at_50%_50%,transparent_25%,black_80%)]"
	>
		<span class="text-[clamp(5rem,18vw,12rem)] -rotate-8 absolute top-[2%] left-[-5%]"
			>RENOVABIT</span
		>
		<span class="text-[clamp(4rem,14vw,9rem)] rotate-12 absolute top-[8%] right-[-8%]"
			>REPARACIÓN</span
		>
		<span class="text-[clamp(5rem,16vw,11rem)] -rotate-12 absolute top-[35%] left-[-3%]"
			>AREQUIPA</span
		>
		<span class="text-[clamp(4rem,14vw,9rem)] rotate-8 absolute top-[30%] right-[-5%]">LAPTOP</span>
		<span class="text-[clamp(5.5rem,18vw,12rem)] -rotate-3 absolute top-[55%] left-[5%]"
			>GARANTÍA</span
		>
		<span class="text-[clamp(4.5rem,15vw,10rem)] -rotate-10 absolute top-[55%] right-[-2%]"
			>SERVICIO</span
		>
		<span class="text-[clamp(4rem,13vw,9rem)] -rotate-7 absolute top-[78%] left-[3%]"
			>CONFIANZA</span
		>
		<span class="text-[clamp(3.5rem,11vw,7.5rem)] rotate-5 absolute top-[78%] right-[5%]"
			>CALIDAD</span
		>
	</div>
</div>
