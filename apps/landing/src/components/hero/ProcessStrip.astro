---
import { Icon } from "astro-icon/components"

interface Step {
	number: string
	icon: string
	title: string
	meta: string
}

interface Props {
	steps: readonly Step[]
	baseDelay?: number
	class?: string
}

const { steps, class: className = "" } = Astro.props

type ReverseMode = "always" | "mobile" | "never"

type Item =
	| {
			kind: "step"
			index: number
			gridArea: string
			delayClass: string
	  }
	| {
			kind: "connector"
			between: [number, number]
			gridArea: string | null
			desktopOnly: boolean
			delayClass: string
			reverse: ReverseMode
	  }

const stepDelayClass = (i: number) => {
	const map: Record<number, string> = {
		0: "animate-delay-300",
		1: "animate-delay-400",
		2: "animate-delay-500",
		3: "animate-delay-700",
	}
	return map[i] ?? "animate-delay-100"
}

// Mobile 2x2 visual order: 1 (TL) → 2 (TR) → 3 (BL) → 4 (BR).
// Step 3 moves to bottom-LEFT and step 4 to bottom-RIGHT so the bottom row reads LTR.
// DOM order stays semantic (1, 2, 3, 4); CSS grid-area + flex order handle visuals.
const items: Item[] = [
	{ kind: "step", index: 0, gridArea: "1 / 1", delayClass: stepDelayClass(0) },
	{
		kind: "connector",
		between: [0, 1],
		gridArea: "1 / 2",
		desktopOnly: false,
		delayClass: "animate-delay-500",
		reverse: "never",
	},
	{ kind: "step", index: 1, gridArea: "1 / 3", delayClass: stepDelayClass(1) },
	{
		kind: "connector",
		between: [1, 2],
		gridArea: null,
		desktopOnly: true,
		delayClass: "animate-delay-800",
		reverse: "never",
	},
	{ kind: "step", index: 2, gridArea: "2 / 1", delayClass: stepDelayClass(2) },
	{
		kind: "connector",
		between: [2, 3],
		gridArea: "2 / 2",
		desktopOnly: false,
		delayClass: "animate-delay-900",
		reverse: "never",
	},
	{ kind: "step", index: 3, gridArea: "2 / 3", delayClass: stepDelayClass(3) },
]
---

<ol
	class={`m-0 grid w-full max-w-4xl list-none grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] grid-rows-2 items-center justify-items-center gap-x-3 gap-y-3 p-0 md:flex md:w-full md:max-w-3xl md:flex-row md:items-stretch md:justify-center md:gap-0 ${className}`}
	role="list"
	aria-label="Proceso de servicio"
>
	{
		items.map((item) => {
			if (item.kind === "connector") {
				const svgClass =
					item.reverse === "mobile"
						? "[transform:scaleX(-1)] md:transform-none"
						: item.reverse === "always"
							? "[transform:scaleX(-1)]"
							: ""
				const wrapperClass = item.desktopOnly
					? `hidden md:flex md:items-center md:justify-center md:self-stretch md:px-2 md:text-muted-foreground/30 motion-safe:animate-fade-in motion-safe:animate-duration-700 ${item.delayClass}`
					: `flex items-center justify-center self-stretch px-1 text-muted-foreground/30 motion-safe:animate-fade-in motion-safe:animate-duration-700 md:px-2 ${item.delayClass}`
				const areaClass = item.gridArea ? `[grid-area:${item.gridArea.replace(/\s/g, "")}]` : ""
				return (
					<li class="contents" role="presentation" aria-hidden="true">
						<div class={`${wrapperClass} ${areaClass}`}>
							<svg
								class={`block ${svgClass}`}
								width="32"
								height="12"
								viewBox="0 0 32 12"
								fill="none"
							>
								<path
									d="M0 6 H28 M22 2 L28 6 L22 10"
									stroke="currentColor"
									stroke-width="1"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</div>
					</li>
				)
			}

			const step = steps[item.index]
			const areaClass = `[grid-area:${item.gridArea.replace(/\s/g, "")}]`
			return (
				<li class="contents" role="listitem">
					<div
						class={`group flex w-full flex-1 flex-col items-center gap-1 text-center motion-safe:animate-fade-in-up motion-safe:animate-duration-700 ${item.delayClass} ${areaClass}`}
					>
						<span
							class="font-eyebrow text-[9px] font-medium tracking-[0.18em] text-primary md:text-[10px] md:tracking-[0.22em]"
							aria-hidden="true"
						>
							{step.number}
						</span>
						<Icon name={step.icon} class="size-5 text-primary md:size-6" aria-hidden="true" />
						<h3 class="font-display m-0 text-[clamp(0.8125rem,1.4vw,1.0625rem)] font-semibold leading-[1.2] tracking-[-0.01em] text-foreground">
							{step.title}
						</h3>
						<p class="m-0 hidden max-w-[18ch] text-[12px] leading-[1.4] text-muted-foreground text-balance md:block">
							{step.meta}
						</p>
					</div>
				</li>
			)
		})
	}
</ol>
