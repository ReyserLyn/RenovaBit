---
import { Icon } from "astro-icon/components"
import { NAV_ITEMS } from "@/constants"
import Button from "../ui/Button.astro"
import { Card, CardContent } from "../ui/card"

interface Props {
	whatsappUrl: string
}

const { whatsappUrl } = Astro.props
---

<div class="group/menu md:hidden">
	<button
		type="button"
		class="inline-flex size-10 items-center justify-center rounded-lg text-foreground transition-colors hover:bg-accent"
		aria-expanded="false"
		aria-controls="mobile-menu-panel"
		aria-label="Abrir menú de navegación"
		id="mobile-menu-trigger"
	>
		<Icon name="hugeicons:menu-01" size={22} class="group-aria-expanded/menu:hidden" />
		<Icon name="hugeicons:cancel-01" size={22} class="hidden group-aria-expanded/menu:inline" />
	</button>

	<Card
		id="mobile-menu-panel"
		class="absolute right-0 left-0 top-full z-50 mt-3 shadow-2xl backdrop-blur-xl transition-all duration-300 ease-out opacity-0 -translate-y-3 scale-[0.95] pointer-events-none group-aria-expanded/menu:opacity-100 group-aria-expanded/menu:translate-y-0 group-aria-expanded/menu:scale-100 group-aria-expanded/menu:pointer-events-auto"
	>
		<CardContent>
			<nav class="flex flex-col gap-1" aria-label="Navegación móvil">
				{
					NAV_ITEMS.map((item) => (
						<Button
							as="a"
							variant="ghost"
							href={item.href}
							class="w-full justify-start text-foreground/70"
						>
							{item.label}
						</Button>
					))
				}
			</nav>

			<div class="my-4 h-px bg-linear-to-r from-transparent via-border to-transparent"></div>

			<Button
				as="a"
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Contactar por WhatsApp (se abre en nueva pestaña)"
				class="w-full"
				size="lg"
			>
				Contáctanos
			</Button>
		</CardContent>
	</Card>
</div>

<script>
	const trigger = document.getElementById("mobile-menu-trigger")
	const panel = document.getElementById("mobile-menu-panel")

	if (trigger instanceof HTMLButtonElement && panel) {
		const setOpen = (open: boolean) => {
			trigger.setAttribute("aria-expanded", String(open))
			trigger.setAttribute(
				"aria-label",
				open ? "Cerrar menú de navegación" : "Abrir menú de navegación",
			)
		}

		const isOpen = () => trigger.getAttribute("aria-expanded") === "true"

		trigger.addEventListener("click", () => {
			setOpen(!isOpen())
		})

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && isOpen()) {
				setOpen(false)
				trigger.focus()
			}
		})

		// Close menu when a link inside is activated
		panel.addEventListener("click", (e) => {
			if (e.target instanceof HTMLAnchorElement) {
				setOpen(false)
			}
		})
	}
</script>
