---
import { Icon } from "astro-icon/components"
import { NAV_ITEMS } from "@/constants"
import Button from "../ui/Button.astro"
import { Card, CardContent } from "../ui/card"

interface Props {
	whatsappUrl: string
}

const { whatsappUrl } = Astro.props
---

<div class="group md:hidden">
	<div
		class="inline-flex size-10 cursor-pointer items-center justify-center rounded-lg text-foreground transition-colors hover:bg-accent has-checked:bg-accent/50"
		role="button"
		tabindex="0"
		aria-expanded="false"
		aria-label="Abrir menú de navegación"
		id="mobile-menu-trigger"
	>
		<input type="checkbox" id="mobile-menu-toggle" class="peer hidden" autocomplete="off" />

		<Icon name="hugeicons:menu-01" size={22} class="peer-checked:hidden" />
		<Icon name="hugeicons:cancel-01" size={22} class="hidden peer-checked:inline" />
	</div>

	<Card
		class="absolute right-4 left-4 top-full mt-3 shadow-2xl backdrop-blur-xl transition-all duration-300 ease-out opacity-0 -translate-y-3 scale-[0.95] pointer-events-none group-has-checked:opacity-100 group-has-checked:translate-y-0 group-has-checked:scale-100 group-has-checked:pointer-events-auto"
	>
		<CardContent>
			<nav class="flex flex-col gap-1" aria-label="Navegación móvil">
				{
					NAV_ITEMS.map((item) => (
						<Button
							as="a"
							variant="ghost"
							href={item.href}
							onclick="document.getElementById('mobile-menu-toggle').checked = false"
							class="w-full justify-start text-foreground/70"
						>
							{item.label}
						</Button>
					))
				}
			</nav>

			<div class="my-4 h-px bg-linear-to-r from-transparent via-border to-transparent"></div>

			<Button
				as="a"
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Contactar por WhatsApp (se abre en nueva pestaña)"
				onclick="document.getElementById('mobile-menu-toggle').checked = false"
				class="w-full"
				size="lg"
			>
				Contáctanos
			</Button>
		</CardContent>
	</Card>
</div>

<script>
	const toggle = document.getElementById("mobile-menu-toggle")
	const trigger = document.getElementById("mobile-menu-trigger")

	if (toggle && toggle instanceof HTMLInputElement && trigger) {
		// Click en el botón togglea el checkbox
		trigger.addEventListener("click", (e) => {
			e.stopPropagation()
			toggle.checked = !toggle.checked
			updateAria()
		})

		// Teclado: Enter o Space
		trigger.addEventListener("keydown", (e) => {
			if (e.key === "Enter" || e.key === " ") {
				e.preventDefault()
				toggle.checked = !toggle.checked
				updateAria()
			}
		})

		// Escape cierra el menú
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && toggle.checked) {
				toggle.checked = false
				updateAria()
			}
		})

		function updateAria() {
			if (!toggle || !(toggle instanceof HTMLInputElement)) return
			if (!trigger) return

			trigger.setAttribute("aria-expanded", String(toggle.checked))
			trigger.setAttribute(
				"aria-label",
				toggle.checked ? "Cerrar menú de navegación" : "Abrir menú de navegación",
			)
		}

		// Si alguien más cambia el checkbox (ej: clic en link del menú)
		toggle.addEventListener("change", updateAria)
	}
</script>
